{
  "version": "0.2",
  "language": "en",
  "import": ["@cspell/dict-rust/cspell-ext.json"],
  "dictionaries": ["typescript", "javascript", "html", "css", "node", "mdx", "rust", "softwareTerms"],
  "enabledFileTypes": {
    "rust": true,
    "markdown": true,
    "mdx": true,
    "ocaml": true
  },
  "words": [
    "astro",
    "astrojs",
    "caml",
    "fira",
    "functor",
    "mario",
    "menhir",
    "merlin",
    "metavariable",
    "mli",
    "mll",
    "mly",
    "Nullary",
    "ocaml",
    "ocamlc",
    "ocamllex",
    "ocamlopt",
    "ocamlyacc",
    "opam",
    "ounit",
    "pagefind",
    "ppx",
    "runtest",
    "tsconfigs",
    "tseslint",
    "utop",
    "yepes"
  ],
  "ignorePaths": [
    ".cspell.json",
    ".git/",
    ".gitattributes",
    ".gitignore",
    ".vscode/**",
    "node_modules/**",
    ".astro/**",
    "dist/**",
    ".output/**",
    "public/**",
    "pagefind/**",
    "_build/**",
    ".opam/**"
  ]
}
