---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@src/consts';

import { Code } from 'astro-expressive-code/components';
import Quiz from '@components/quiz/Quiz.astro';
import QuizReview from '@components/quiz/QuizReview.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="px-6" data-pagefind-body>
      <h1>Demo</h1>

      <!-- DEMO START -->
      <Quiz
        question="What is the capital of France?"
        options={['Berlin', 'Madrid', 'Paris', 'Rome']}
        correctOption={[2]}
      >
        <Code slot="questionSlot" code="console.log('Hello world!')" lang="js" />
        <Code code="console.log('Hello world!')" lang="js" />
      </Quiz>

      <QuizReview question="What is the capital of France?">
        <p>The capital of France is Paris.</p>
      </QuizReview>
      <!-- DEMO END -->
    </main>
  </body>
</html>
